# Supabase — Project Settings > API
# Safe to expose to the browser (RLS restricts what it can actually do).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — Project Settings > API > service_role secret
# SERVER-ONLY. Never expose this to the browser. Required because RLS denies
# anonymous access to customers, appointments, and contact_messages entirely;
# only trusted server code (Server Actions) uses this key to read/write those
# tables after performing its own validation and availability checks.
SUPABASE_SERVICE_ROLE_KEY=

# Resend — https://resend.com/api-keys
# SERVER-ONLY. Never expose this to the browser.
RESEND_API_KEY=

# Verified sender address for outgoing email (Resend > Domains).
# Until a domain is verified, Resend's shared sandbox sender can be used for
# testing: onboarding@resend.dev (delivers only to the account owner's email).
RESEND_FROM_EMAIL=onboarding@resend.dev

# Mailbox that receives contact form submissions.
CONTACT_RECEIVER_EMAIL=
